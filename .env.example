POSTGRES_PORT=5433
POSTGRESQL_POSTGRES_PASSWORD=postgres
POSTGRESQL_USERNAME=api_tickets
POSTGRESQL_PASSWORD=api_tickets
POSTGRESQL_DATABASE=api_tickets

DATABASE_URL=postgresql://api_tickets:api_tickets@localhost:5433/api_tickets?schema=public

# Redis: porta publicada pelo Compose e URL usada pela aplicação
REDIS_PUBLISHED_PORT=6381
REDIS_URL=redis://localhost:6381

# Origens permitidas para a API HTTP e o WebSocket (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# JWT Secret - OBRIGATÓRIO: deve ser uma string forte e aleatória (mínimo 32 caracteres)
# Gere um novo com: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# NVIDIA API Key - OBRIGATÓRIO: obtenha no NVIDIA API Catalog
NVIDIA_API_KEY=your-nvidia-api-key-here

# Modelo NVIDIA usado pelo chat e pelo RAG
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Observe APM credentials
OBSERVE_APP_KEY=your-observe-app-key
OBSERVE_APP_SECRET=your-observe-app-secret

POSTGRES_PORT=5432
POSTGRESQL_POSTGRES_PASSWORD=postgres
POSTGRESQL_USERNAME=api_tickets
POSTGRESQL_PASSWORD=api_tickets
POSTGRESQL_DATABASE=api_tickets

DATABASE_URL=postgresql://api_tickets:api_tickets@localhost:5432/api_tickets?schema=public

# JWT Secret - OBRIGATÓRIO: deve ser uma string forte e aleatória (mínimo 32 caracteres)
# Gere um novo com: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
